// ==============================================================================
// Gin Web Framework for Aura Language
// examples/quickstart.aura - Minimal Quickstart Server
// ==============================================================================

import { Default, PongHandler } from "../gin";
import { GinContext } from "../context";

export fn main(): Unit => {
  // Initialize Default Gin Engine with Logger and Recovery middleware
  let mut r = Default();

  // Simple Ping / Pong health check endpoint
  r.GET("/ping", PongHandler);

  // Standard JSON response
  r.GET("/", fn(c: GinContext): Unit => {
    c.JSON(StatusOK, {
      framework: "Gin Web Framework for Aura Language",
      version: "v1.10.0-aura",
      status: "operational"
    });
  });

  // Dynamic parameterized greeting
  r.GET("/hello/:name", fn(c: GinContext): Unit => {
    let name = c.Param("name");
    c.String(StatusOK, `Hello, ${name}! Welcome to Gin for Aura.`);
  });

  println("Starting Gin quickstart server on :8080...");
  r.Run(":8080");
}
