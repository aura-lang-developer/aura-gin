// ==============================================================================
// Gin Web Framework for Aura Language
// examples/csp_streaming.aura - CSP Concurrency, Fibers & SSE Live Streaming
// ==============================================================================

import { Default } from "../gin";
import { GinContext } from "../context";
import { StreamChannel, EventHub, NewEventHub, Async } from "../channels";

export fn main(): Unit => {
  let mut r = Default();

  // Central EventHub for pub/sub message broadcasting
  let mut hub = NewEventHub();

  // 1. Server-Sent Events (SSE) live data stream using CSP Channel
  r.GET("/stream/ticks", fn(c: GinContext): Unit => {
    let tickChan: Channel<String> = Channel.make<String>(10);

    // Producer fiber generating live ticker events
    spawn {
      let mut count = 1;
      while count <= 5 {
        sleep(1000);
        tickChan <- `Tick event #${count} at ${time.isoString()}`;
        count += 1;
      };
      // Auto-closing channel terminates SSE stream
      Channel.close(tickChan);
    };

    // StreamChannel streams chunked data over HTTP directly to the client
    StreamChannel(&c, tickChan);
  });

  // 2. Pub/Sub Real-time Chat or Event Stream
  r.GET("/stream/events", fn(c: GinContext): Unit => {
    let subChan: Channel<String> = Channel.make<String>(20);
    hub.Subscribe(subChan);

    StreamChannel(&c, subChan);
  });

  // Endpoint to broadcast an event to all connected streaming clients
  r.POST("/broadcast", fn(c: GinContext): Unit => {
    let bindRes = c.BindJSON();
    match bindRes {
      Ok(payload) => {
        let msg = if payload.message != null { `${payload.message}` } else { "broadcast ping" };
        hub.Broadcast(msg);
        c.JSON(StatusOK, { status: "broadcast sent", message: msg });
      },
      Err(e) => {
        c.JSON(StatusBadRequest, { error: e });
      }
    };
  });

  // 3. Background Async Fiber Task using c.Copy()
  // The HTTP response completes immediately, while a background fiber processes heavy work
  r.POST("/tasks/async-report", fn(c: GinContext): Unit => {
    // Dispatch background fiber with isolated context copy
    Async(&c, fn(asyncCtx: *GinContext): Unit => {
      println("\n[Worker Fiber] Beginning heavy report generation in background fiber...");
      sleep(3000);
      println("[Worker Fiber] Report complete for request client: " + asyncCtx.ClientIP());
    });

    // Return instant acknowledgement to the client
    c.JSON(StatusAccepted, {
      status: "accepted",
      message: "Report processing queued in background fiber"
    });
  });

  println("Starting Gin CSP Streaming server on :8080...");
  r.Run(":8080");
}
